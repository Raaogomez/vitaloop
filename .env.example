# ── VitalLoop environment template ──
# Copy to .env and fill in:  cp .env.example .env

# Required: Postgres connection string
# Local example:
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/vitaloop
# Cloud example (Neon / Supabase / Railway):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/vitaloop?sslmode=require

# Required in production: long random strings (generate with: openssl rand -base64 32)
SESSION_SECRET=change-me-to-32-plus-random-chars
ADMIN_KEY=change-me-admin-key
CRON_SECRET=change-me-cron-secret
TELCO_WEBHOOK_SECRET=change-me-telco-secret

# Optional
DCB_MODE=simulator
# DCB_MODE=sandbox   # when you connect a real aggregator sandbox
# DCB_MODE=live      # only with signed telco contracts
NODE_ENV=development
PORT=3000
